{
  "moduleId": "module_calendar",
  "title": "日程安排",
  "description": "修改本地日程时间并保留可撤销的前后版本。",
  "order": 30,
  "actions": [
    {
      "id": "calendar.reschedule",
      "title": "修改日程时间",
      "description": "按日程标题修改开始时间。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "title", "type": "string", "required": true, "description": "日程标题" },
        { "name": "newStartAt", "type": "string", "required": true, "description": "新的 ISO-8601 时间" }
      ]
    }
  ],
  "queries": [
    {
      "id": "calendar.list",
      "title": "日程列表",
      "description": "只读读取模块自有日程集合。",
      "parameters": []
    }
  ],
  "plannerRules": [
    {
      "id": "calendar.rule.reschedule",
      "actionId": "calendar.reschedule",
      "pattern": "^(?:修改|调整|把|将)?\\s*日程\\s+(.+?)\\s+(?:改到|改为|调整到)\\s+(.+)$",
      "argumentGroups": { "title": 1, "newStartAt": 2 },
      "pathArguments": [],
      "wholeGoal": false
    }
  ]
}
