{
  "moduleId": "module_study_assistant",
  "title": "AI 学习助手",
  "description": "只读查看本周学习任务、示例对话、工具轨迹与引用资料。",
  "order": 40,
  "actions": [],
  "queries": [
    {
      "id": "study.assistant.read",
      "title": "读取学习工作台",
      "description": "只读读取模块 JAR 自有的学习工作台数据。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": [
          "schemaVersion",
          "kind",
          "ownerModule",
          "readOnly",
          "title",
          "description",
          "sources",
          "count",
          "payload"
        ],
        "properties": {
          "schemaVersion": { "type": "integer" },
          "kind": { "type": "string" },
          "ownerModule": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind", "location"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" },
          "payload": {
            "type": "object",
            "required": [
              "planner",
              "externalModelConnected",
              "tasks",
              "conversation",
              "toolTrace",
              "citations"
            ],
            "properties": {
              "planner": { "type": "string" },
              "externalModelConnected": { "type": "boolean" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "detail"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              },
              "conversation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "role", "content", "readOnly"],
                  "properties": {
                    "id": { "type": "string" },
                    "role": { "type": "string" },
                    "content": { "type": "string" },
                    "readOnly": { "type": "boolean" }
                  }
                }
              },
              "toolTrace": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label", "state", "detail"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "state": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "sourceId", "title", "excerpt"],
                  "properties": {
                    "id": { "type": "string" },
                    "sourceId": { "type": "string" },
                    "title": { "type": "string" },
                    "excerpt": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "display": {
        "prompt": "以列表展示学习任务的标题和详情；没有任务时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "payload.tasks",
        "fields": [
          { "key": "title", "label": "学习任务", "format": "text" },
          { "key": "detail", "label": "详情", "format": "text" }
        ],
        "emptyText": "暂无学习任务"
      }
    }
  ],
  "plannerRules": []
}
