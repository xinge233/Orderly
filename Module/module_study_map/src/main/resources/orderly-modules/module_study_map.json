{
  "moduleId": "module_study_map",
  "title": "知识脉络",
  "description": "只读浏览高等数学知识节点、先修关系与课程筛选。",
  "order": 40,
  "actions": [],
  "queries": [
    {
      "id": "study.map.read",
      "title": "读取知识图谱",
      "description": "只读读取模块 JAR 内的高等数学节点和关系。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": [
          "schemaVersion",
          "kind",
          "ownerModule",
          "readOnly",
          "title",
          "description",
          "sources",
          "count",
          "payload"
        ],
        "properties": {
          "schemaVersion": { "type": "integer" },
          "kind": { "type": "string" },
          "ownerModule": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind", "location"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" },
          "payload": {
            "type": "object",
            "required": ["nodes", "edges"],
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label",
                    "category",
                    "courseId",
                    "summary",
                    "sourceIds",
                    "layer",
                    "order"
                  ],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "category": { "type": "string" },
                    "courseId": { "type": "string" },
                    "summary": { "type": "string" },
                    "sourceIds": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "layer": { "type": "integer" },
                    "order": { "type": "integer" }
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "source", "target", "label", "kind"],
                  "properties": {
                    "id": { "type": "string" },
                    "source": { "type": "string" },
                    "target": { "type": "string" },
                    "label": { "type": "string" },
                    "kind": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "display": {
        "prompt": "以列表展示知识节点的名称、分类、课程和摘要；没有节点时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "payload.nodes",
        "fields": [
          { "key": "label", "label": "知识节点", "format": "text" },
          { "key": "category", "label": "分类", "format": "status" },
          { "key": "courseId", "label": "课程", "format": "text" },
          { "key": "summary", "label": "摘要", "format": "text" }
        ],
        "emptyText": "暂无知识节点"
      }
    }
  ],
  "plannerRules": []
}
