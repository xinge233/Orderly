{
  "moduleId": "module_system_control",
  "title": "模组设置",
  "description": "统一管理本机业务模块的启停、排序与模块设置。",
  "order": 10000,
  "actions": [
    {
      "id": "module_system_control.module.set_enabled",
      "title": "设置模块启停",
      "description": "在用户确认后启用或停用指定业务模块。拒绝系统模块，并保存前一状态、审计记录和失败回滚依据。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        {
          "name": "moduleId",
          "type": "string",
          "required": true,
          "description": "目标业务模块 ID"
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true,
          "description": "true 启用模块，false 停用模块"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "moduleId": { "type": "string" },
          "previousEnabled": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "changed": { "type": "boolean" },
          "revision": { "type": "string" }
        },
        "required": ["moduleId", "previousEnabled", "enabled", "changed", "revision"],
        "additionalProperties": false
      }
    },
    {
      "id": "module_system_control.interface.set_callable",
      "title": "设置接口 AI 可调用状态",
      "description": "在用户确认后设置指定业务模块特定 Action 或 Query 的 AI 可调用状态。关闭使用中的 Action 会被拒绝，且不阻断模块自身或本地界面调用。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        {
          "name": "moduleId",
          "type": "string",
          "required": true,
          "description": "目标业务模块 ID"
        },
        {
          "name": "kind",
          "type": "string",
          "required": true,
          "description": "接口类型，只能是 action 或 query"
        },
        {
          "name": "interfaceId",
          "type": "string",
          "required": true,
          "description": "目标 Action 或 Query ID"
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true,
          "description": "true 允许 AI 调用，false 禁止 AI 调用"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "moduleId": { "type": "string" },
          "kind": { "type": "string" },
          "interfaceId": { "type": "string" },
          "previousEnabled": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "changed": { "type": "boolean" },
          "revision": { "type": "string" }
        },
        "required": [
          "moduleId",
          "kind",
          "interfaceId",
          "previousEnabled",
          "enabled",
          "changed",
          "revision"
        ],
        "additionalProperties": false
      }
    }
  ],
  "queries": [
    {
      "id": "module_system_control.module.list",
      "title": "查询业务模块",
      "description": "返回业务模块标识、标题、启用状态、管理排序和接口数量摘要，不返回系统模块或敏感设置正文。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": ["items", "count", "revision"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "moduleId",
                "title",
                "description",
                "enabled",
                "managementOrder",
                "settingsCount",
                "actionCount",
                "queryCount"
              ],
              "properties": {
                "moduleId": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "enabled": { "type": "boolean" },
                "managementOrder": { "type": "integer" },
                "settingsCount": { "type": "integer" },
                "actionCount": { "type": "integer" },
                "queryCount": { "type": "integer" }
              }
            }
          },
          "count": { "type": "integer" },
          "revision": { "type": "string" }
        }
      },
      "display": {
        "prompt": "以列表展示业务模块标题、标识、启用状态和接口数量；没有业务模块时显示空状态。",
        "fallbackLayout": "table",
        "rowPath": "items",
        "fields": [
          { "key": "title", "label": "模块", "format": "text" },
          { "key": "moduleId", "label": "模块标识", "format": "text" },
          { "key": "enabled", "label": "启用", "format": "boolean" },
          { "key": "actionCount", "label": "动作数", "format": "number" },
          { "key": "queryCount", "label": "查询数", "format": "number" },
          { "key": "managementOrder", "label": "管理排序", "format": "number" }
        ],
        "emptyText": "暂无业务模块"
      }
    },
    {
      "id": "module_system_control.interface.list",
      "title": "查询模块接口",
      "description": "返回业务模块 Action/Query 的元数据、风险、AI 可调用状态和使用中状态，可按模块与接口类型过滤。",
      "parameters": [
        {
          "name": "moduleId",
          "type": "string",
          "required": false,
          "description": "可选业务模块 ID"
        },
        {
          "name": "kind",
          "type": "string",
          "required": false,
          "description": "可选接口类型，只能是 action 或 query"
        }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["items", "count", "revision"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "moduleId",
                "moduleTitle",
                "kind",
                "interfaceId",
                "title",
                "description",
                "aiCallable",
                "inUse"
              ],
              "properties": {
                "moduleId": { "type": "string" },
                "moduleTitle": { "type": "string" },
                "kind": { "type": "string" },
                "interfaceId": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "risk": { "type": "string" },
                "aiCallable": { "type": "boolean" },
                "inUse": { "type": "boolean" }
              }
            }
          },
          "count": { "type": "integer" },
          "revision": { "type": "string" }
        }
      },
      "display": {
        "prompt": "以列表展示模块、接口类型、接口名称、风险、AI 可调用状态和使用中状态；没有匹配接口时显示空状态。",
        "fallbackLayout": "table",
        "rowPath": "items",
        "fields": [
          { "key": "moduleTitle", "label": "模块", "format": "text" },
          { "key": "interfaceId", "label": "接口", "format": "text" },
          { "key": "kind", "label": "类型", "format": "status" },
          { "key": "risk", "label": "风险", "format": "status" },
          { "key": "aiCallable", "label": "AI 可调用", "format": "boolean" },
          { "key": "inUse", "label": "使用中", "format": "boolean" }
        ],
        "emptyText": "暂无匹配接口"
      }
    },
    {
      "id": "module_system_control.setting.get",
      "title": "读取模块设置",
      "description": "读取指定业务模块的设置字段定义和当前有效值。原始结果默认只留在本地前端，不自动发送给模型。",
      "parameters": [
        {
          "name": "moduleId",
          "type": "string",
          "required": true,
          "description": "目标业务模块 ID"
        }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["moduleId", "title", "fields", "values", "revision"],
        "properties": {
          "moduleId": { "type": "string" },
          "title": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "type", "label", "description", "options"],
              "properties": {
                "key": { "type": "string" },
                "type": { "type": "string" },
                "label": { "type": "string" },
                "description": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["value", "label"],
                    "properties": {
                      "value": { "type": "string" },
                      "label": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "revision": { "type": "string" }
        }
      },
      "display": {
        "prompt": "以键值摘要展示模块标识、模块标题和设置版本；没有设置数据时显示空状态。",
        "fallbackLayout": "keyValue",
        "fields": [
          { "key": "title", "label": "模块", "format": "text" },
          { "key": "moduleId", "label": "模块标识", "format": "text" },
          { "key": "revision", "label": "设置版本", "format": "text" }
        ],
        "emptyText": "暂无设置数据"
      }
    }
  ],
  "plannerRules": [],
  "system": {
    "role": "MODULE_CONTROL",
    "protected": true,
    "capabilities": ["MODULE_GOVERNANCE"]
  }
}
