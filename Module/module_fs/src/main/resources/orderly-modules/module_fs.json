{
  "moduleId": "module_fs",
  "title": "资料管理",
  "description": "浏览课程资料，并在应用自管沙箱内通过受控计划创建、移动和回收文件。",
  "order": 10,
  "actions": [
    {
      "id": "fs.list",
      "title": "列出目录",
      "description": "只读列出工作区目录内容。",
      "risk": "READ_ONLY",
      "confirmationRequired": false,
      "parameters": [
        { "name": "path", "type": "string", "required": false, "description": "工作区相对路径" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["path", "entries"],
        "properties": {
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    {
      "id": "fs.mkdir",
      "title": "创建目录",
      "description": "在工作区创建目录。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "新目录相对路径" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" }
        }
      }
    },
    {
      "id": "fs.move",
      "title": "移动或重命名",
      "description": "在工作区内移动或重命名文件。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "source", "type": "string", "required": true, "description": "源相对路径" },
        { "name": "target", "type": "string", "required": true, "description": "目标相对路径" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    },
    {
      "id": "fs.trash",
      "title": "移入回收站",
      "description": "将对象移入项目回收站，不执行物理删除。",
      "risk": "DELETE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "待移入回收站的相对路径" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["trashEntry"],
        "properties": {
          "trashEntry": { "type": "object" }
        }
      }
    },
    {
      "id": "fs.restore",
      "title": "从回收站恢复",
      "description": "按回收站条目恢复原对象。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "trashId", "type": "string", "required": true, "description": "回收站条目 ID" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" }
        }
      }
    }
  ],
  "queries": [
    {
      "id": "fs.list",
      "title": "列出目录",
      "description": "只读列出工作区目录内容。",
      "parameters": [
        { "name": "path", "type": "string", "required": false, "description": "工作区相对路径" }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["path", "entries", "count"],
        "properties": {
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path", "directory", "size", "modifiedAt"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "directory": { "type": "boolean" },
                "size": { "type": "integer" },
                "modifiedAt": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      },
      "display": {
        "prompt": "以列表展示目录中的条目名称、类型、大小和修改时间；目录为空时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "entries",
        "fields": [
          { "key": "name", "label": "名称", "format": "text" },
          { "key": "directory", "label": "目录", "format": "boolean" },
          { "key": "size", "label": "大小", "format": "number" },
          { "key": "modifiedAt", "label": "修改时间", "format": "datetime" }
        ],
        "emptyText": "暂无目录条目"
      }
    },
    {
      "id": "fs.materials",
      "title": "资料目录",
      "description": "只读读取模块 classpath 内的课程与学习资料。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": [
          "schemaVersion",
          "kind",
          "ownerModule",
          "readOnly",
          "title",
          "description",
          "sources",
          "count",
          "payload"
        ],
        "properties": {
          "schemaVersion": { "type": "integer" },
          "kind": { "type": "string" },
          "ownerModule": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind", "location"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" },
          "payload": {
            "type": "object",
            "required": ["courses", "materials"],
            "properties": {
              "courses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "code", "description"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "code": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "materials": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "courseId",
                    "chapter",
                    "format",
                    "status",
                    "sourceId",
                    "excerpt",
                    "cards"
                  ],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "courseId": { "type": "string" },
                    "chapter": { "type": "string" },
                    "format": { "type": "string" },
                    "status": { "type": "string" },
                    "sourceId": { "type": "string" },
                    "excerpt": { "type": "string" },
                    "cards": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "title", "summary"],
                        "properties": {
                          "id": { "type": "string" },
                          "title": { "type": "string" },
                          "summary": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "display": {
        "prompt": "以列表展示资料标题、课程、格式和整理状态；没有资料时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "payload.materials",
        "fields": [
          { "key": "title", "label": "资料", "format": "text" },
          { "key": "courseId", "label": "课程", "format": "text" },
          { "key": "format", "label": "格式", "format": "text" },
          { "key": "status", "label": "状态", "format": "status" }
        ],
        "emptyText": "暂无课程资料"
      }
    },
    {
      "id": "fs.summary",
      "title": "文件摘要",
      "description": "读取工作区根目录的条目数量和摘要。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": ["path", "entries", "count"],
        "properties": {
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "path", "directory", "size", "modifiedAt"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "directory": { "type": "boolean" },
                "size": { "type": "integer" },
                "modifiedAt": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      },
      "display": {
        "prompt": "以列表展示工作区根目录的条目名称、类型、大小和修改时间；根目录为空时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "entries",
        "fields": [
          { "key": "name", "label": "名称", "format": "text" },
          { "key": "directory", "label": "目录", "format": "boolean" },
          { "key": "size", "label": "大小", "format": "number" },
          { "key": "modifiedAt", "label": "修改时间", "format": "datetime" }
        ],
        "emptyText": "工作区暂无条目"
      }
    },
    {
      "id": "fs.trash",
      "title": "回收站",
      "description": "只读列出项目回收站条目。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": ["entries", "count"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "originalPath", "storedPath", "name", "deletedAt"],
              "properties": {
                "id": { "type": "string" },
                "originalPath": { "type": "string" },
                "storedPath": { "type": "string" },
                "name": { "type": "string" },
                "deletedAt": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      },
      "display": {
        "prompt": "以列表展示回收站条目的名称、原位置和删除时间；回收站为空时显示空状态。",
        "fallbackLayout": "list",
        "rowPath": "entries",
        "fields": [
          { "key": "name", "label": "名称", "format": "text" },
          { "key": "originalPath", "label": "原位置", "format": "text" },
          { "key": "deletedAt", "label": "删除时间", "format": "datetime" }
        ],
        "emptyText": "回收站暂无条目"
      }
    }
  ],
  "plannerRules": [
    {
      "id": "fs.rule.mkdir",
      "actionId": "fs.mkdir",
      "pattern": "^(?:创建|新建)(?:目录|文件夹)\\s*[：:]?\\s*(.+)$",
      "argumentGroups": { "path": 1 },
      "pathArguments": [ "path" ],
      "wholeGoal": false
    },
    {
      "id": "fs.rule.move",
      "actionId": "fs.move",
      "pattern": "^移动\\s+(.+?)\\s+到\\s+(.+)$",
      "argumentGroups": { "source": 1, "target": 2 },
      "pathArguments": [ "source", "target" ],
      "wholeGoal": false
    },
    {
      "id": "fs.rule.trash",
      "actionId": "fs.trash",
      "pattern": "^(?:删除|移入回收站)\\s*[：:]?\\s*(.+)$",
      "argumentGroups": { "path": 1 },
      "pathArguments": [ "path" ],
      "wholeGoal": false
    }
  ]
}
