{
  "moduleId": "module_fs",
  "title": "资料管理",
  "description": "浏览课程资料，并在应用自管沙箱内通过受控计划创建、移动和回收文件。",
  "order": 10,
  "actions": [
    {
      "id": "fs.list",
      "title": "列出目录",
      "description": "只读列出工作区目录内容。",
      "risk": "READ_ONLY",
      "confirmationRequired": false,
      "parameters": [
        { "name": "path", "type": "string", "required": false, "description": "工作区相对路径" }
      ]
    },
    {
      "id": "fs.mkdir",
      "title": "创建目录",
      "description": "在工作区创建目录。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "新目录相对路径" }
      ]
    },
    {
      "id": "fs.move",
      "title": "移动或重命名",
      "description": "在工作区内移动或重命名文件。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "source", "type": "string", "required": true, "description": "源相对路径" },
        { "name": "target", "type": "string", "required": true, "description": "目标相对路径" }
      ]
    },
    {
      "id": "fs.trash",
      "title": "移入回收站",
      "description": "将对象移入项目回收站，不执行物理删除。",
      "risk": "DELETE",
      "confirmationRequired": true,
      "confirmationPhrase": "删除",
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "待移入回收站的相对路径" }
      ]
    },
    {
      "id": "fs.restore",
      "title": "从回收站恢复",
      "description": "按回收站条目恢复原对象。",
      "risk": "WRITE",
      "confirmationRequired": true,
      "parameters": [
        { "name": "trashId", "type": "string", "required": true, "description": "回收站条目 ID" }
      ]
    }
  ],
  "queries": [
    {
      "id": "fs.list",
      "title": "列出目录",
      "description": "只读列出工作区目录内容。",
      "parameters": [
        { "name": "path", "type": "string", "required": false, "description": "工作区相对路径" }
      ]
    },
    {
      "id": "fs.materials",
      "title": "资料目录",
      "description": "只读读取模块 classpath 内的课程与学习资料。",
      "parameters": []
    },
    {
      "id": "fs.summary",
      "title": "文件摘要",
      "description": "读取工作区根目录的条目数量和摘要。",
      "parameters": []
    },
    {
      "id": "fs.trash",
      "title": "回收站",
      "description": "只读列出项目回收站条目。",
      "parameters": []
    }
  ],
  "plannerRules": [
    {
      "id": "fs.rule.mkdir",
      "actionId": "fs.mkdir",
      "pattern": "^(?:创建|新建)(?:目录|文件夹)\\s*[：:]?\\s*(.+)$",
      "argumentGroups": { "path": 1 },
      "pathArguments": [ "path" ],
      "wholeGoal": false
    },
    {
      "id": "fs.rule.move",
      "actionId": "fs.move",
      "pattern": "^移动\\s+(.+?)\\s+到\\s+(.+)$",
      "argumentGroups": { "source": 1, "target": 2 },
      "pathArguments": [ "source", "target" ],
      "wholeGoal": false
    },
    {
      "id": "fs.rule.trash",
      "actionId": "fs.trash",
      "pattern": "^(?:删除|移入回收站)\\s*[：:]?\\s*(.+)$",
      "argumentGroups": { "path": 1 },
      "pathArguments": [ "path" ],
      "wholeGoal": false
    }
  ]
}
