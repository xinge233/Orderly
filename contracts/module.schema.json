{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/module.schema.json",
  "title": "Orderly module contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleId",
    "title",
    "description",
    "order",
    "actions",
    "queries",
    "plannerRules"
  ],
  "properties": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "order": { "type": "integer" },
    "system": { "$ref": "#/$defs/systemMetadata" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/query" }
    },
    "plannerRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/plannerRule" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "moduleId": { "pattern": "^module_system_" }
        },
        "required": ["moduleId"]
      },
      "then": { "required": ["system"] }
    },
    {
      "if": { "required": ["system"] },
      "then": {
        "properties": {
          "moduleId": { "pattern": "^module_system_" }
        }
      }
    }
  ],
  "$defs": {
    "systemMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "protected", "capabilities"],
      "properties": {
        "role": { "enum": ["MODULE_CONTROL", "SYSTEM_SERVICE"] },
        "protected": { "const": true },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["MODULE_GOVERNANCE"] }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "MODULE_CONTROL" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "capabilities": { "contains": { "const": "MODULE_GOVERNANCE" } }
            }
          }
        },
        {
          "if": {
            "properties": { "role": { "const": "SYSTEM_SERVICE" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "capabilities": { "not": { "contains": { "const": "MODULE_GOVERNANCE" } } }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "boolean", "integer"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "risk",
        "confirmationRequired",
        "parameters"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["READ_ONLY", "WRITE", "DELETE"] },
        "confirmationRequired": { "type": "boolean" },
        "confirmationPhrase": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "outputSchema": { "$ref": "#/$defs/outputSchema" }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["object", "array", "string", "integer", "number", "boolean", "null"]
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/outputSchema" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "items": { "$ref": "#/$defs/outputSchema" },
        "additionalProperties": {
          "oneOf": [
            { "type": "boolean" },
            { "$ref": "#/$defs/outputSchema" }
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "parameters"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "outputSchema": { "$ref": "#/$defs/outputSchema" },
        "display": { "$ref": "#/$defs/queryDisplay" }
      }
    },
    "queryDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "fallbackLayout"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fallbackLayout": {
          "enum": ["keyValue", "list", "table", "text", "timeline"]
        },
        "rowPath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/queryDisplayField" }
        },
        "emptyText": { "type": "string", "maxLength": 200 },
        "density": { "enum": ["compact", "comfortable"] },
        "groupBy": { "enum": ["none", "date"] },
        "hideRepeatedFields": { "type": "boolean" },
        "detailFields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/queryDisplayField" }
        },
        "emphasisFields": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "fallbackLayout": { "const": "timeline" } },
            "required": ["fallbackLayout"]
          },
          "then": {
            "required": ["fields"],
            "properties": {
              "fields": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "time" } }
                    }
                  },
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "primary" } }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "groupBy": { "const": "date" } },
            "required": ["groupBy"]
          },
          "then": {
            "properties": {
              "fields": {
                "contains": {
                  "required": ["role"],
                  "properties": { "role": { "const": "time" } }
                }
              }
            }
          }
        }
      ]
    },
    "queryDisplayField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "format"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "format": {
          "enum": ["text", "status", "date", "time", "datetime", "number", "boolean"]
        },
        "role": {
          "enum": ["time", "primary", "secondary", "status"]
        },
        "valueLabels": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "time" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "format": { "enum": ["date", "time", "datetime"] }
            }
          }
        }
      ]
    },
    "plannerRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actionId",
        "pattern",
        "argumentGroups",
        "pathArguments",
        "wholeGoal"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_.-]+$" },
        "actionId": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "argumentGroups": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "pathArguments": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "wholeGoal": { "type": "boolean" }
      }
    }
  }
}
