{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/ai-turn-request.schema.json",
  "title": "Orderly AI Natural Language Turn Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "clientRequestId"],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "conversationId": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
