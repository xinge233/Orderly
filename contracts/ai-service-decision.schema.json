{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/ai-service-decision.schema.json",
  "title": "Orderly Python to Java AI Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "conversationId"],
  "properties": {
    "kind": {
      "enum": ["ACTIONS", "PLAN", "QUESTION", "QUERY", "VIEW"]
    },
    "conversationId": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/query" }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "options"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "view": {
      "$ref": "#/$defs/view"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["ACTIONS", "PLAN"] } } },
      "then": {
        "required": ["actions"],
        "not": {
          "anyOf": [
            { "required": ["queries"] },
            { "required": ["question"] },
            { "required": ["view"] }
          ]
        },
        "properties": {
          "actions": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "QUESTION" } } },
      "then": {
        "required": ["question"],
        "not": {
          "anyOf": [
            { "required": ["actions"] },
            { "required": ["queries"] },
            { "required": ["view"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "QUERY" } } },
      "then": {
        "required": ["queries"],
        "not": {
          "anyOf": [
            { "required": ["actions"] },
            { "required": ["question"] },
            { "required": ["view"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "VIEW" } } },
      "then": {
        "required": ["view"],
        "not": {
          "anyOf": [
            { "required": ["actions"] },
            { "required": ["queries"] },
            { "required": ["question"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceQuery", "layout", "title", "fields"],
      "properties": {
        "sourceQuery": { "type": "integer", "minimum": 1, "maximum": 4 },
        "layout": { "enum": ["keyValue", "list", "table", "text", "timeline"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rowPath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/viewField" }
        },
        "detailFields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/viewField" }
        },
        "emptyText": { "type": "string", "maxLength": 200 },
        "density": { "enum": ["compact", "comfortable"] },
        "groupBy": { "enum": ["none", "date"] },
        "hideRepeatedFields": { "type": "boolean" },
        "emphasisFields": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "layout": { "const": "timeline" } },
            "required": ["layout"]
          },
          "then": {
            "properties": {
              "fields": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "time" } }
                    }
                  },
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "primary" } }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "groupBy": { "const": "date" } },
            "required": ["groupBy"]
          },
          "then": {
            "properties": {
              "fields": {
                "contains": {
                  "required": ["role"],
                  "properties": { "role": { "const": "time" } }
                }
              }
            }
          }
        }
      ]
    },
    "viewField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "format"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "format": {
          "enum": ["text", "status", "date", "time", "datetime", "number", "boolean"]
        },
        "role": {
          "enum": ["time", "primary", "secondary", "status"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "time" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "format": { "enum": ["date", "time", "datetime"] }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "actionId", "arguments"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "queryId", "arguments"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "queryId": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "integer", "null"]
          }
        }
      }
    }
  }
}
