{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/ai-query-continuation-request.schema.json",
  "title": "Orderly Java to Python Query Result Continuation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "conversationId",
    "clientRequestId",
    "aiPlanEnabled",
    "modules",
    "queryResults"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "conversationId": { "type": "string", "minLength": 1 },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aiPlanEnabled": { "type": "boolean" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "queryResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "queryId", "status", "message"],
        "properties": {
          "moduleId": { "type": "string", "minLength": 1 },
          "queryId": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["OK", "FAILED", "TRUNCATED"]
          },
          "payload": {
            "oneOf": [
              { "type": "object" },
              { "type": "array" },
              { "type": "null" }
            ]
          },
          "message": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": { "status": { "const": "OK" } }
            },
            "then": {
              "required": ["payload"],
              "properties": {
                "payload": {
                  "oneOf": [
                    { "type": "object" },
                    { "type": "array" }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": { "enum": ["FAILED", "TRUNCATED"] }
              }
            },
            "then": {
              "properties": {
                "payload": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "boolean", "integer"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "title", "description", "risk", "parameters"],
      "properties": {
        "actionId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["READ_ONLY", "WRITE", "DELETE"] },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queryId", "title", "description", "parameters"],
      "properties": {
        "queryId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "outputSchema": { "type": "object" },
        "display": { "$ref": "#/$defs/queryDisplay" }
      }
    },
    "queryDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "fallbackLayout"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fallbackLayout": {
          "enum": ["keyValue", "list", "table", "text", "timeline"]
        },
        "rowPath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/queryDisplayField" }
        },
        "emptyText": { "type": "string", "maxLength": 200 },
        "density": { "enum": ["compact", "comfortable"] },
        "groupBy": { "enum": ["none", "date"] },
        "hideRepeatedFields": { "type": "boolean" },
        "detailFields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/queryDisplayField" }
        },
        "emphasisFields": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "fallbackLayout": { "const": "timeline" } },
            "required": ["fallbackLayout"]
          },
          "then": {
            "required": ["fields"],
            "properties": {
              "fields": {
                "allOf": [
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "time" } }
                    }
                  },
                  {
                    "contains": {
                      "required": ["role"],
                      "properties": { "role": { "const": "primary" } }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "groupBy": { "const": "date" } },
            "required": ["groupBy"]
          },
          "then": {
            "properties": {
              "fields": {
                "contains": {
                  "required": ["role"],
                  "properties": { "role": { "const": "time" } }
                }
              }
            }
          }
        }
      ]
    },
    "queryDisplayField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "format"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "format": {
          "enum": ["text", "status", "date", "time", "datetime", "number", "boolean"]
        },
        "role": {
          "enum": ["time", "primary", "secondary", "status"]
        },
        "valueLabels": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "time" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "format": { "enum": ["date", "time", "datetime"] }
            }
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "title", "description", "actions", "queries"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "queries": {
          "type": "array",
          "items": { "$ref": "#/$defs/query" }
        }
      }
    }
  }
}
