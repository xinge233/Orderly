{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/module-catalog.schema.json",
  "title": "Orderly module distribution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "generatedAt",
    "modules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": 1 },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "title",
        "description",
        "version",
        "packagePath",
        "sha256",
        "size"
      ],
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^module_(?!system_)[a-z0-9_]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "packagePath": {
          "type": "string",
          "pattern": "^packages/[A-Za-z0-9._/-]+\\.zip$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        }
      }
    }
  }
}
