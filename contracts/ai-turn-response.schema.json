{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/ai-turn-response.schema.json",
  "title": "Orderly AI Natural Language Turn Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "requestId", "conversationId", "message"],
  "properties": {
    "kind": {
      "enum": ["ACTIONS", "PLAN", "QUESTION", "QUERY", "VIEW"]
    },
    "requestId": { "type": "string", "minLength": 1 },
    "conversationId": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "highestRisk": {
      "enum": ["READ_ONLY", "WRITE", "DELETE"]
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/query" }
    },
    "queryResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/queryResult" }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "goal", "status", "highestRisk", "steps", "createdAt", "expiresAt"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "highestRisk": {
          "enum": ["READ_ONLY", "WRITE", "DELETE"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "moduleId", "actionId", "title", "description", "risk", "arguments"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "moduleId": { "type": "string", "minLength": 1 },
              "actionId": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "risk": {
                "enum": ["READ_ONLY", "WRITE", "DELETE"]
              },
              "arguments": { "type": "object" }
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceQuery", "layout", "title", "fields"],
      "properties": {
        "sourceQuery": { "type": "integer", "minimum": 1, "maximum": 4 },
        "layout": { "enum": ["keyValue", "list", "table", "text"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rowPath": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "format"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 160 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "format": {
                "enum": ["text", "status", "datetime", "number", "boolean"]
              }
            }
          }
        },
        "emptyText": { "type": "string", "maxLength": 200 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "options"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "execution": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "PLAN" } } },
      "then": { "required": ["plan"] }
    },
    {
      "if": { "properties": { "kind": { "const": "QUESTION" } } },
      "then": { "required": ["question"] }
    },
    {
      "if": { "properties": { "kind": { "const": "ACTIONS" } } },
      "then": { "required": ["actions", "highestRisk"] }
    },
    {
      "if": { "properties": { "kind": { "const": "QUERY" } } },
      "then": {
        "required": ["queries", "queryResults"],
        "not": { "required": ["view"] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "VIEW" } } },
      "then": {
        "required": ["queryResults", "view"],
        "not": {
          "anyOf": [
            { "required": ["actions"] },
            { "required": ["plan"] },
            { "required": ["question"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "actionId", "arguments"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "queryId", "arguments"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "queryId": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "boolean", "integer", "null"]
          }
        }
      }
    },
    "queryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "queryId", "status", "message"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "queryId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["OK", "FAILED", "TRUNCATED"]
        },
        "payload": {
          "oneOf": [
            { "type": "object" },
            { "type": "array" },
            { "type": "null" }
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "OK" } }
          },
          "then": {
            "required": ["payload"],
            "properties": {
              "payload": {
                "oneOf": [
                  { "type": "object" },
                  { "type": "array" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["FAILED", "TRUNCATED"] }
            }
          },
          "then": {
            "properties": {
              "payload": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
