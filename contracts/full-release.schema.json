{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/full-release.schema.json",
  "title": "Orderly full Windows application release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "projectVersion",
    "gitCommit",
    "gitDirty",
    "sourceTreeSha256",
    "jdkMajor",
    "launchMode",
    "dataRootPolicy",
    "hostJar",
    "desktopLauncher",
    "desktopHost",
    "webView2Runtime",
    "aiExecutable",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packageType": {
      "const": "orderly-full-windows"
    },
    "projectVersion": {
      "type": "string",
      "minLength": 1
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "gitDirty": {
      "type": "boolean"
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "jdkMajor": {
      "const": 21
    },
    "launchMode": {
      "const": "packaged"
    },
    "dataRootPolicy": {
      "enum": [
        "LOCALAPPDATA_OR_ORDERLY_DATA_DIR"
      ]
    },
    "hostJar": {
      "$ref": "#/$defs/artifact"
    },
    "desktopLauncher": {
      "$ref": "#/$defs/artifact"
    },
    "desktopHost": {
      "$ref": "#/$defs/artifact"
    },
    "webView2Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "version", "path"],
      "properties": {
        "mode": {
          "enum": ["evergreen", "fixed"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "aiExecutable": {
      "$ref": "#/$defs/artifact"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "path", "size", "sha256"],
        "properties": {
          "moduleId": {
            "$ref": "#/$defs/moduleId"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^module_[a-z0-9_]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:).*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
