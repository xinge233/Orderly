{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/file-root-authorization.schema.json",
  "title": "Orderly File Root Authorization Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmed", "path", "label", "allowWrite", "allowDelete"],
  "properties": {
    "confirmed": { "const": true },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
    },
    "label": { "type": "string", "maxLength": 80 },
    "allowWrite": { "type": "boolean" },
    "allowDelete": { "type": "boolean" }
  }
}
