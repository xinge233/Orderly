{
  "moduleId": "module_demo",
  "title": "演示模块",
  "description": "用于契约校验的通用演示模块。",
  "order": 10,
  "actions": [
    {
      "id": "demo.read",
      "title": "读取演示值",
      "description": "读取一个演示参数。",
      "risk": "READ_ONLY",
      "confirmationRequired": false,
      "parameters": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "演示值"
        }
      ],
      "outputSchema": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string" }
        }
      }
    }
  ],
  "queries": [
    {
      "id": "demo.list",
      "title": "列出演示项",
      "description": "返回演示项集合。",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "status": { "type": "string" }
              }
            }
          }
        }
      },
      "display": {
        "prompt": "按标题和状态展示为列表，空集合显示暂无演示项。",
        "fallbackLayout": "list",
        "rowPath": "items",
        "fields": [
          { "key": "title", "label": "标题", "format": "text" },
          { "key": "status", "label": "状态", "format": "status" }
        ],
        "emptyText": "暂无演示项"
      }
    }
  ],
  "plannerRules": [
    {
      "id": "demo.read",
      "actionId": "demo.read",
      "pattern": "^读取演示 (.+)$",
      "argumentGroups": {
        "value": 1
      },
      "pathArguments": [],
      "wholeGoal": true
    }
  ]
}
