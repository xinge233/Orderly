{
  "version": 1,
  "view": {
    "id": "settings-demo",
    "caption": "设置示例",
    "icon": "settings"
  },
  "examples": [],
  "settings": {
    "fields": [
      {
        "key": "showDetails",
        "type": "boolean",
        "label": "显示详情",
        "description": "控制摘要是否展开。",
        "default": true
      },
      {
        "key": "pageSize",
        "type": "integer",
        "label": "每页条数",
        "default": 20,
        "min": 1,
        "max": 100
      },
      {
        "key": "sortBy",
        "type": "select",
        "label": "排序方式",
        "default": "name",
        "options": [
          { "value": "name", "label": "名称" },
          { "value": "modified", "label": "修改时间" }
        ]
      },
      {
        "key": "note",
        "type": "text",
        "label": "备注",
        "default": "",
        "placeholder": "可选备注",
        "maxLength": 80
      }
    ]
  },
  "script": "module.js",
  "style": "module.css"
}
