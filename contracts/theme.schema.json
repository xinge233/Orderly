{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/theme.schema.json",
  "title": "Orderly directory theme manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "order", "styles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "label": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "order": { "type": "integer", "minimum": 0 },
    "default": { "type": "boolean" },
    "colorScheme": { "enum": ["", "light", "dark"] },
    "browserColor": { "type": "string", "minLength": 1 },
    "styles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": { "const": "tokens.css" }
        },
        {
          "contains": { "const": "motion.css" }
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9][a-z0-9.-]*/)*[a-z0-9][a-z0-9.-]*\\.css$"
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^assets/(?:[a-z0-9][a-z0-9.-]*/)*[a-z0-9][a-z0-9.-]*\\.(?:png|jpe?g|webp|gif|avif|woff2?|ttf|otf)$"
      }
    }
  }
}
