{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/module-ui.schema.json",
  "title": "Orderly module UI manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "view", "examples", "script", "style"],
  "properties": {
    "version": { "const": 1 },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "icon"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "caption": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "badge", "icon", "countKey", "unit"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "badge": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "queryId": { "type": "string" },
        "countKey": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.js$"
    },
    "style": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.css$"
    }
  }
}
