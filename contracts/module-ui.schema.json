{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/module-ui.schema.json",
  "title": "Orderly module UI manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "view", "examples", "script", "style"],
  "properties": {
    "version": { "const": 1 },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "icon"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "caption": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "badge", "icon", "countKey", "unit"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "badge": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "queryId": { "type": "string" },
        "countKey": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "settings": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/booleanField" },
                  { "$ref": "#/$defs/integerField" },
                  { "$ref": "#/$defs/selectField" },
                  { "$ref": "#/$defs/textField" }
                ]
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/booleanField" },
              { "$ref": "#/$defs/integerField" },
              { "$ref": "#/$defs/selectField" },
              { "$ref": "#/$defs/textField" }
            ]
          }
        }
      ]
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.js$"
    },
    "style": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.css$"
    }
  },
  "$defs": {
    "fieldBase": {
      "type": "object",
      "required": ["key", "type", "default"],
      "anyOf": [
        { "required": ["label"] },
        { "required": ["title"] }
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "booleanField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": { "const": "boolean" },
            "label": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "default": { "type": "boolean" }
          }
        }
      ]
    },
    "integerField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": { "const": "integer" },
            "label": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "default": { "type": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        }
      ]
    },
    "selectOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "selectField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["options"],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": { "const": "select" },
            "label": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "default": { "type": "string", "minLength": 1 },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/selectOption" }
            }
          }
        }
      ]
    },
    "textField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": { "const": "text" },
            "label": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "default": { "type": "string" },
            "placeholder": { "type": "string" },
            "minLength": { "type": "integer", "minimum": 0 },
            "maxLength": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
