{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/runtime-release.schema.json",
  "title": "Orderly prebuilt runtime release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "projectVersion",
    "gitCommit",
    "sourceTreeSha256",
    "jdkMajor",
    "themesRoot",
    "hostJar",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageType": {
      "const": "orderly-runtime"
    },
    "projectVersion": {
      "type": "string",
      "minLength": 1
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "jdkMajor": {
      "const": 21
    },
    "themesRoot": {
      "$ref": "#/$defs/relativePath"
    },
    "hostJar": {
      "$ref": "#/$defs/artifact"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "artifact"],
        "properties": {
          "moduleId": {
            "$ref": "#/$defs/moduleId"
          },
          "artifact": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^module_[a-z0-9_]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:).*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
