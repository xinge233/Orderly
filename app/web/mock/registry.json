    {
      "id": "demo.write.archive",
      "name": "归档项目",
      "summary": "展示可撤销归档能力的界面条目",
      "risk": "write",
      "params": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "演示归档目标"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "status": "ok"
      },
      "inverse": {
        "type": "restore_archive"
      },
      "irreversible": false,
      "ui": {
        "icon": "archive",
        "entry": "sidebar.item",
        "accent": "accent.primary"
      },
      "settings": [
        {
          "key": "archive.retention",
          "label": "保留天数",
          "control": "number",
          "default": 30,
          "min": 7,
          "max": 365,
          "step": 1
        },
        {
          "key": "archive.quiet",
          "label": "完成后提示",
          "control": "toggle",
          "default": true
        },
        {
          "key": "archive.group",
          "label": "归档方式",
          "control": "select",
          "default": "按月",
          "options": ["按日", "按周", "按月"]
        }
      ],
      "version": "0.1.0"
    },
    {
      "id": "demo.write.todo",
      "name": "整理待办",
