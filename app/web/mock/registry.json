{
  "_note": "S1 静态演示数据，不会读取用户文件，也不会调用任何模块实现。",
  "modules": [
    {
      "id": "demo.read.notes",
      "name": "查阅笔记",
      "summary": "展示笔记读取能力的界面条目",
      "risk": "read_only",
      "params": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "演示关键词"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "status": "ok"
      },
      "inverse": null,
      "irreversible": false,
      "ui": {
        "icon": "file",
        "entry": "sidebar.item",
        "accent": "accent.primary"
      },
      "settings": [],
      "version": "0.1.0"
    },
    {
      "id": "demo.read.calendar",
