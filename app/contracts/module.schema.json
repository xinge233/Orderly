{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderly.local/contracts/module.schema.json",
  "title": "Orderly module contract",
  "description": "S1 module contract. The authoritative field table defines 11 top-level fields; the task card's reference to 12 fields is recorded as a documentation typo.",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary",
    "risk",
    "params",
    "result",
    "inverse",
    "irreversible",
    "ui",
    "settings",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
      "description": "Globally unique dotted module identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[\\p{L}\\p{N}]+(?: [\\p{L}\\p{N}]+)*$",
      "description": "Display name without punctuation."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Capability summary for the model; it must not describe an effect."
    },
    "risk": {
      "type": "string",
      "enum": [
        "read_only",
        "write",
        "delete"
      ],
      "description": "Risk tier used to derive authorization and interface flow."
    },
    "params": {
      "type": "object",
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type",
              "description"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": false,
      "description": "JSON Schema 2020-12 for an object-shaped parameter list."
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "partial"
          ]
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "errorCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "inverse": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Structured module result. Free-text fields are forbidden."
    },
    "inverse": {
      "type": [
        "object",
        "null"
      ],
      "description": "Inverse operation declaration. Read-only modules may use null; write and delete modules must use an object unless the delete is explicitly irreversible."
    },
    "irreversible": {
      "type": "boolean",
      "description": "True only when the operation cannot be reversed."
    },
    "ui": {
      "type": "object",
      "required": [
        "icon",
        "entry",
        "accent"
      ],
      "properties": {
        "icon": {
          "type": "string",
          "enum": [
            "archive",
            "calendar",
            "file",
            "folder",
            "search",
            "settings",
            "spark",
            "todo"
          ]
        },
        "entry": {
          "const": "sidebar.item"
        },
        "accent": {
          "type": "string",
          "enum": [
            "accent.primary",
            "accent.secondary"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Interface declaration. Module never supplies DOM, styles, or flow."
    },
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "key",
              "label",
              "control",
              "default",
              "min",
              "max",
              "step"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "control": {
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "key",
              "label",
              "control",
              "default"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "control": {
                "const": "toggle"
              },
              "default": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "key",
              "label",
              "control",
              "default",
              "options"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "control": {
                "const": "select"
              },
              "default": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "description": "Zero or more module settings using number, toggle, or select controls."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Semantic version for explicit compatibility changes."
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "risk": {
          "const": "read_only"
        },
        "inverse": {
          "type": "null"
        },
        "irreversible": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "risk": {
          "const": "write"
        },
        "inverse": {
          "type": "object"
        },
        "irreversible": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "risk": {
          "const": "delete"
        },
        "inverse": {
          "type": "object"
        },
        "irreversible": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "risk": {
          "const": "delete"
        },
        "inverse": {
          "type": "null"
        },
        "irreversible": {
          "const": true
        }
      }
    }
  ]
}
